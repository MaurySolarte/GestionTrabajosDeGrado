<AnchorPane prefHeight="560.0" prefWidth="698.0" styleClass="center-pane" stylesheets="@dashboardprofesor.css" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.unicauca.proyectogestion.controllers.CoordinadorEvaluarFormatoController">
